# ResolveFlow AI — environment configuration
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# Every value below is OPTIONAL. With no GEMINI_API_KEY the agent still runs
# end to end using deterministic rule-based fallbacks (used by the test suite).

# --- Gemini LLM (optional; enables live reasoning instead of fallbacks) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Default model used when the primary/secondary aliases are not set.
GEMINI_MODEL=gemini-2.5-flash
# Two-model split (Feature 0): heavy model for planning/response,
# light model for high-frequency classification/scoring.
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_MODEL=gemini-2.5-flash-lite

# --- Demo time anchor ---
# The seeded ConnectCare world is dated in May/June 2026. Tool calls that do not
# pass an explicit date treat "now" as this anchor so date-windowed scenarios
# (duplicate charge, outage credit) keep working regardless of the real clock.
# Set to a real ISO date (e.g. 2026-06-17) to use the live clock instead.
# RESOLVEFLOW_NOW=2026-06-01

# --- Database path override ---
# Defaults to data/resolveflow_demo.db if present, else data/resolveflow.db.
# RESOLVEFLOW_DB_PATH=data/resolveflow.db

# --- Evidence receipt signing (set before any public/deployed use) ---
# HMAC key used to sign tamper-evident tool-evidence receipts. Falls back to a
# well-known dev key with a startup warning if unset -- receipts are NOT
# tamper-evident until you set a real value here.
# RESOLVEFLOW_RECEIPT_SECRET=

# --- Agent-desk write-endpoint token (set before any public/deployed use) ---
# Shared secret required (as the x-agent-desk-token header) to POST replies or
# resolve escalations via the agent-desk API. Unset by default for local dev
# (endpoints are open, with a startup warning); set the same value here and as
# NEXT_PUBLIC_AGENT_DESK_TOKEN in frontend/.env.local before deploying.
# RESOLVEFLOW_AGENT_DESK_TOKEN=
